# Daily Canvas 后端配置

# 数据库配置
# PostgreSQL 连接 URL
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daily_canvas

# JWT 密钥
# 生产环境请使用复杂的随机字符串
SECRET_KEY=your-secret-key-change-in-production

# CORS 配置
# 允许的前端地址
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]