# Daily Canvas 后端配置

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daily_canvas
# 必填：不要使用默认值，生成命令：openssl rand -hex 32
SECRET_KEY=
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# 登录暴力破解防护（进程内滑窗；隧道下按账号计数是主要防线，按 IP 只是宽松兜底）
LOGIN_MAX_FAILURES_PER_ACCOUNT=8
LOGIN_MAX_FAILURES_PER_IP=200
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
LOGIN_IP_LOCKOUT_SECONDS=300
REGISTER_MAX_ATTEMPTS_PER_IP=60
REGISTER_WINDOW_SECONDS=3600
REGISTER_LOCKOUT_SECONDS=600
# 管理端（举报后台）最小账号：两个都填才会在启动时创建，留空则不建账号
STAFF_USERNAME=
STAFF_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost,https://localhost
